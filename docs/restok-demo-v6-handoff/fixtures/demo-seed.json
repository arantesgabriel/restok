  "screenMeta": {
    "compra": {
      "title": "Compra",
      "subtitle": "Primeira dobra, preço e estados",
      "icon": "basket",
      "why": "A lista é a tarefa principal. Total, meta e filtros ocupam menos altura; ações persistentes não encobrem produtos.",
      "rules": [
        "Uma linha inteira acima do dock em 320 px.",
        "Preço zero diferente de preço ausente.",
        "Confirmação de item sem saltos ou espera artificial."
      ],
      "findings": [
        "UI-001 · Visibilidade",
        "UI-003/004 · Preço",
        "UI-010 · Meta"
      ]
    },
    "casa": {
      "title": "Casa",
      "subtitle": "Catálogo e recorrência",
      "icon": "home",
      "why": "Busca local, categorias e ações organizadas eliminam o esforço de encontrar produtos recorrentes.",
      "rules": [
        "Busca disponível antes da lista.",
        "Ações de adicionar e Já temos distintas.",
        "Estados vazios informativos por filtro."
      ],
      "findings": [
        "UI-009 · Busca",
        "UI-008 · Quantidade",
        "UI-005 · Densidade"
      ]
    },
    "historico": {
      "title": "Histórico",
      "subtitle": "Compras e comparação",
      "icon": "history",
      "why": "Cada compra tem identidade, data, total e detalhe. Variações de preço aparecem junto ao produto, não em gráficos decorativos.",
      "rules": [
        "Leitura cronológica e agrupamento mensal.",
        "Diferenças sempre contextualizadas por unidade.",
        "Estado vazio claro em casas sem compras."
      ],
      "findings": [
        "UI-005 · Desktop",
        "UI-004 · Valor",
        "UI-011 · Feedback"
      ]
    },
    "pessoas": {
      "title": "Casas e pessoas",
      "subtitle": "Identidade e permissões",
      "icon": "people",
      "why": "O nome completo precede papel e controles de acesso. A casa ativa aparece em todas as telas, inclusive após recarga simulada.",
      "rules": [
        "Identidade em bloco próprio, com quebra de linha.",
        "Confirmação antes de alterações sensíveis.",
        "Troca de casa com contexto explícito."
      ],
      "findings": [
        "UI-002 · Identidade",
        "UI-013 · Casa ativa",
        "UI-006 · Conta individual"
      ]
