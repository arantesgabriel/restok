+    expect(screen.getByRole("button", { name: "Editar Somente casa b" })).toBeTruthy();
+  });
+
+  it.each(["malformed", "a".repeat(36)])("keeps preference for invalid/failed invitation %s and removes it from URL", async (invite) => {
