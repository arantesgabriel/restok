--- a/components/shopping/status-toggle.tsx
+++ b/components/shopping/status-toggle.tsx
@@ -1,7 +1,58 @@
 import { Check, Circle, House } from "lucide-react";
 import type { ItemStatus } from "@/lib/types";
 import { statusLabel } from "@/lib/utils";
+import { IconButton } from "@/components/ui/icon-button";
 import { OptionGroup } from "@/components/ui/option-group";
 import styles from "./shopping-controls.module.css";
-export function StatusToggle({value,onChange}:{value:ItemStatus;onChange:(value:ItemStatus)=>void}) {return <div className="restok-theme"><p>Situação</p><OptionGroup label="Situação" value={value} onChange={onChange} options={(["pending","purchased","already_have"] as const).map(value=>({value,label:statusLabel(value)}))}/></div>;}
-export function StatusBadge({status}:{status:ItemStatus}) {const Icon=status==="purchased"?Check:status==="already_have"?House:Circle;return <span className={`restok-theme ${styles.badge}`} data-status={status}><Icon size={14} aria-hidden="true"/>{statusLabel(status)}</span>;}
+import shoppingStyles from "./shopping.module.css";
+
+export function StatusToggle({ value, onChange }: { value: ItemStatus; onChange: (value: ItemStatus) => void }) {
+  return (
+    <div className="restok-theme">
+      <p>Situação</p>
+      <OptionGroup
+        label="Situação"
+        value={value}
+        onChange={onChange}
+        options={(["pending", "purchased", "already_have"] as const).map((status) => ({ value: status, label: statusLabel(status) }))}
+      />
+    </div>
+  );
+}
+
+export function ShoppingStatusButton({
+  name,
+  status,
+  onPurchased,
+  onUndo,
+}: {
+  name: string;
+  status: ItemStatus;
+  onPurchased: () => void;
+  onUndo: () => void;
+}) {
+  const Icon = status === "pending" ? Circle : status === "purchased" ? Check : House;
+  const label = status === "pending" ? `Marcar ${name} como comprado` : `Desfazer situação de ${name}`;
+
+  return (
+    <IconButton
+      className={shoppingStyles.statusButton}
+      label={label}
+      aria-pressed={status !== "pending"}
+      onClick={status === "pending" ? onPurchased : onUndo}
+    >
+      <Icon size={20} aria-hidden="true" />
+    </IconButton>
+  );
+}
+
+export function StatusBadge({ status }: { status: ItemStatus }) {
+  const Icon = status === "purchased" ? Check : status === "already_have" ? House : Circle;
+
+  return (
+    <span className={`restok-theme ${styles.badge}`} data-status={status}>
+      <Icon size={14} aria-hidden="true" />
+      {statusLabel(status)}
+    </span>
+  );
+}
